{
  // Cloudflare Workers config (HOM-864, HOM-2027).
  //
  // Static assets are served directly and never reach Worker code. Only /api/*
  // runs the Worker, for the checker's "Search online" button. Everything is
  // still hand-written or generated and committed, so there is no build step.
  "name": "basketvitality-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    // Served from the repo root. .assetsignore keeps non-site files such as this
    // one, the Worker source and the scripts from being served.
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // No Worker logs or traces. The Worker handles search text, and the policy
  // says we don't log it.
  "observability": { "enabled": false },
  "ratelimits": [
    {
      // Open Food Facts allows 10 searches a minute per IP, and every visitor
      // shares this Worker. The cap is approximate and per Cloudflare location.
      "name": "OFF_SEARCH_LIMIT",
      "namespace_id": "2027",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
